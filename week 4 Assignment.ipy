# ---------------------------------------------------------
# TASK 1 - Functional transaction processing
# ---------------------------------------------------------

def clean_transactions(amounts, min_threshold=10.0):
    """Keep only positive amounts that are at least min_threshold."""
    # filter() keeps an amount only if the lambda returns True
    valid = filter(lambda amount: amount > 0 and amount >= min_threshold, amounts)
    # filter() gives a filter object, so list() turns it into a list
    return list(valid)


def apply_service_fee(amounts, fee_rate=0.02):
    """Deduct a percentage service fee from every amount."""
    # map() applies the lambda to every amount
    processed = map(lambda amount: amount - (amount * fee_rate), amounts)
    # map() gives a map object, so list() turns it into a list
    return list(processed)


# ---------------------------------------------------------
# TASK 2 - Purely recursive nested total
# ---------------------------------------------------------

def calculate_nested_total(data):
    """Return the total of a number or an arbitrarily nested list of numbers."""
    # Base case 2: a single number (int or float) -> return it
    if isinstance(data, (int, float)):
        return data

    # Base case 1: an empty list -> total is 0.0
    if data == []:
        return 0.0

    # Recursive step: split the list into head and tail
    head = data[0]      # first item (a number or another list)
    tail = data[1:]     # everything after the first item (always a list)

    # Resolve both parts recursively and add them
    return calculate_nested_total(head) + calculate_nested_total(tail)


